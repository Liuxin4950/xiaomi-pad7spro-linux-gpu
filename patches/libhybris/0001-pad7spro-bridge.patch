+/* POSIX scanf's %m modifier allocates with glibc. Preserve normal scanf
+ * conversions, but reject allocation formats before consuming input or
+ * assigning output pointers. Walk conversions, including scansets, so a
+ * literal "m" or "%m" inside a scanset is not treated as a modifier. */
+static int _hybris_bridge_scanf_allocates(const char *fmt)
+{
+    const unsigned char *cursor = (const unsigned char *)fmt;
+    while (*cursor) {
+        if (*cursor++ != '%')
+            continue;
+        if (*cursor == '%') {
+            cursor++;
+            continue;
+        }
+        while (*cursor) {
+            unsigned char ch = *cursor++;
+            if (ch == 'm')
+                return 1;
+            if (strchr("diouxXfFeEgGaAcCsSpn[", ch)) {
+                if (ch == '[') {
+                    if (*cursor == '^')
+                        cursor++;
+                    if (*cursor == ']')
+                        cursor++;
+                    while (*cursor && *cursor != ']')
+                        cursor++;
+                    if (*cursor)
+                        cursor++;
+                }
+                break;
+            }
+            if (!(strchr("*'$IhljztLq", ch) || (ch >= '0' && ch <= '9')))
+                break; /* Invalid conversion; leave diagnosis to libc. */
+        }
+    }
+    return 0;
+}
+
+static int _hybris_bridge_vsscanf(const char *input, const char *fmt, va_list args)
+{
+    if (_hybris_bridge_scanf_allocates(fmt)) {
+        errno = ENOSYS;
+        return EOF;
+    }
+    return vsscanf(input, fmt, args);
+}
+
+static int _hybris_bridge_vscanf(const char *fmt, va_list args)
+{
+    if (_hybris_bridge_scanf_allocates(fmt)) {
+        errno = ENOSYS;
+        return EOF;
+    }
+    return vscanf(fmt, args);
+}
+
+FP_ATTRIB static int _hybris_bridge_sscanf(const char *input, const char *fmt, ...)
+{
+    va_list args;
+    va_start(args, fmt);
+    int result = _hybris_bridge_vsscanf(input, fmt, args);
+    va_end(args);
+    return result;
+}
+
+FP_ATTRIB static int _hybris_bridge_scanf(const char *fmt, ...)
+{
+    va_list args;
+    va_start(args, fmt);
+    int result = _hybris_bridge_vscanf(fmt, args);
+    va_end(args);
+    return result;
+}
