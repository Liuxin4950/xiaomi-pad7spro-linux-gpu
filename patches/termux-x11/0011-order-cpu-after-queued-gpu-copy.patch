+/* state->lock excludes an active renderer, but it does not order CPU drawing after
+ * GPU copies that were published before the renderer acquired that lock. Drain that
+ * already-published ownership watermark first, otherwise an old clip can overwrite a
+ * popup painted by this CPU access. Never wait for the main-thread Ack counters here. */
+static Bool lorieLockGpuForCpuAccess(void) {
+    const uint64_t serial = pvfb->gpuCopySerialCounter;
+    const uint64_t deadline = lorieMonotonicNanos() + UINT64_C(2000000000);
+    for (;;) {
+        lorie_mutex_lock(&pvfb->state->lock, &pvfb->state->lockingPid);
+        if (lorieGpuCopyIsDone(serial))
+            return TRUE;
+        lorie_mutex_unlock(&pvfb->state->lock, &pvfb->state->lockingPid);
+        // Renderer completion is published independently of X server work items.
+        // Release the mutex so it can drain, including on its offscreen surface.
+        if (!lorieConnectionAlive() || lorieMonotonicNanos() >= deadline) {
+            dprintf(2, "CPU access refused before queued GPU ownership fence %llu completed\n",
+                    (unsigned long long) serial);
+            return FALSE;
+        }
+        pthread_cond_signal(rendererCond);
+        const struct timespec pause = { .tv_sec = 0, .tv_nsec = 1000000 };
+        nanosleep(&pause, NULL);
+    }
+}
