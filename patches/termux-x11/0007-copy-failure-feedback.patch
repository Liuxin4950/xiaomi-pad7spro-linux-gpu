+// Keep the existing ownership wait on the normal path. A failed fence cannot establish that
+// clients may reuse their source, so only the exceptional path falls back to a full GPU drain.
+void Renderer::finishGpuCopiesLocked(EGLSync fence, uint64_t serial) {
+    bool failed = checkGlError();
+    EGLint waitResult = EGL_FALSE;
+    ATrace_beginSection("PAD_X11.CopyAndRootFenceWait");
+    if (fence != EGL_NO_SYNC_KHR)
+        waitResult = eglClientWaitSyncKHR(egl_display, fence, 0, EGL_FOREVER);
+    ATrace_endSection();
+    if (waitResult != EGL_CONDITION_SATISFIED_KHR) {
+        failed = true;
+        printEglError("GPU ownership fence failed; draining with glFinish", __LINE__);
+        glFinish();
+        checkGlError();
+    }
+    if (fence != EGL_NO_SYNC_KHR && eglDestroySyncKHR(egl_display, fence) != EGL_TRUE) {
+        failed = true;
+        printEglError("Failed to destroy GPU ownership fence", __LINE__);
+    }
+    if (serial) {
+        if (failed)
+            failGpuCopiesLocked(serial);
+        // Release-publish failures first, and completion only after fence success/glFinish.
+        lorieTraceEvent("CopyDone", serial, 0);
+        __atomic_store_n(&state->gpuCopyQueue.completedSerial, serial, __ATOMIC_RELEASE);
+        notifyGpuCopyDone();
+    }
 }
 
