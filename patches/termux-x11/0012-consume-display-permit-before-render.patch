diff --git a/lorie/src/main/cpp/lorie/frame-pacing.h b/lorie/src/main/cpp/lorie/frame-pacing.h
--- a/lorie/src/main/cpp/lorie/frame-pacing.h
+++ b/lorie/src/main/cpp/lorie/frame-pacing.h
@@ -52,3 +52,21 @@
                          elapsed % UINT64_C(1000000000) * rate / UINT64_C(1000000000) + 1;
     return msc > previous ? msc : previous;
 }
+
+/* A permit is consumed BEFORE rendering can block. Ticks during GPU work
+ * reopen it for the next draw; completion must never erase that newer tick.
+ * One byte retains the existing shared-state ABI and coalesces missed ticks. */
+static inline bool lorieFrameGateReady(const volatile uint8_t *waiting)
+{
+    return !__atomic_load_n(waiting, __ATOMIC_ACQUIRE);
+}
+
+static inline bool lorieFrameGateBegin(volatile uint8_t *waiting)
+{
+    return !__atomic_exchange_n(waiting, 1, __ATOMIC_ACQ_REL);
+}
+
+static inline void lorieFrameGateTick(volatile uint8_t *waiting)
+{
+    __atomic_store_n(waiting, 0, __ATOMIC_RELEASE);
+}
