diff --git a/lorie/src/main/cpp/lorie/surface-trace.h b/lorie/src/main/cpp/lorie/surface-trace.h
new file mode 100644
index 0000000..4a19f65
--- /dev/null
+++ b/lorie/src/main/cpp/lorie/surface-trace.h
@@ -0,0 +1,65 @@
+/* SPDX-License-Identifier: MIT */
+#pragma once
+#include "display-trace.h"
+#include <EGL/egl.h>
+#include <EGL/eglext.h>
+#include <string.h>
+
+/* Renderer thread only; bounded history, no idle polling and no waits for
+ * timestamps. Pending/unsupported measurements never become present samples. */
+static EGLuint64KHR lorieTraceSurface(EGLDisplay display, EGLSurface surface) {
+    static EGLSurface previousSurface = EGL_NO_SURFACE;
+    static bool enabled, supported;
+    static PFNEGLGETNEXTFRAMEIDANDROIDPROC nextFrame;
+    static PFNEGLGETFRAMETIMESTAMPSANDROIDPROC timestamps;
+    static PFNEGLGETFRAMETIMESTAMPSUPPORTEDANDROIDPROC timestampSupported;
+    static EGLuint64KHR pending[16];
+    static unsigned count;
+    const bool tracing = ATrace_isEnabled();
+    if (previousSurface != surface) {
+        previousSurface = surface; enabled = supported = false; count = 0;
+    }
+    if (!tracing) {
+        if (enabled) eglSurfaceAttrib(display, surface, EGL_TIMESTAMPS_ANDROID, EGL_FALSE);
+        enabled = false; count = 0;
+        return 0;
+    }
+    if (!enabled) {
+        const char *extensions = eglQueryString(display, EGL_EXTENSIONS);
+        supported = extensions && strstr(extensions, "EGL_ANDROID_get_frame_timestamps");
+        nextFrame = (PFNEGLGETNEXTFRAMEIDANDROIDPROC) eglGetProcAddress("eglGetNextFrameIdANDROID");
+        timestamps = (PFNEGLGETFRAMETIMESTAMPSANDROIDPROC) eglGetProcAddress("eglGetFrameTimestampsANDROID");
+        timestampSupported = (PFNEGLGETFRAMETIMESTAMPSUPPORTEDANDROIDPROC) eglGetProcAddress("eglGetFrameTimestampSupportedANDROID");
+        supported = supported && nextFrame && timestamps && timestampSupported &&
+                    eglSurfaceAttrib(display, surface, EGL_TIMESTAMPS_ANDROID, EGL_TRUE) == EGL_TRUE;
+        enabled = true;
+        lorieTraceEvent("SurfaceTimestampSupport", supported, 0);
+    }
+    if (!supported) return 0;
+    const EGLint requested[] = {EGL_REQUESTED_PRESENT_TIME_ANDROID, EGL_RENDERING_COMPLETE_TIME_ANDROID,
+        EGL_COMPOSITION_LATCH_TIME_ANDROID, EGL_DISPLAY_PRESENT_TIME_ANDROID};
+    EGLint names[4]; unsigned n = 0;
+    for (EGLint name : requested)
+        if (timestampSupported(display, surface, name)) names[n++] = name;
+    unsigned retained = 0;
+    for (unsigned i = 0; i < count; ++i) {
+        EGLnsecsANDROID values[4]; bool stillPending = false;
+        if (n && timestamps(display, surface, pending[i], n, names, values) == EGL_TRUE) {
+            for (unsigned j = 0; j < n; ++j) {
+                if (values[j] == EGL_TIMESTAMP_PENDING_ANDROID) stillPending = true;
+                else if (values[j] > 0) lorieTraceTriple("SurfaceTime", pending[i], names[j], values[j]);
+            }
+            if (stillPending) pending[retained++] = pending[i];
+        } else lorieTraceEvent("SurfaceTimeUnavailable", pending[i], 0);
+    }
+    count = retained;
+    EGLuint64KHR frameId = 0;
+    if (nextFrame(display, surface, &frameId) == EGL_TRUE) {
+        if (count == 16) {
+            lorieTraceEvent("SurfaceTimeDropped", pending[0], 0);
+            memmove(pending, pending+1, 15*sizeof(*pending)); --count;
+        }
+        pending[count++] = frameId;
+    }
+    return frameId;
+}
