diff --git a/lorie/src/main/cpp/lorie/display-trace.h b/lorie/src/main/cpp/lorie/display-trace.h
new file mode 100644
index 0000000..c452578
--- /dev/null
+++ b/lorie/src/main/cpp/lorie/display-trace.h
@@ -0,0 +1,19 @@
+/* SPDX-License-Identifier: MIT */
+#pragma once
+#include <android/trace.h>
+#include <stdint.h>
+#include <stdio.h>
+
+/* Perfetto/atrace opts in; no logging, allocation or image inspection by default.
+ * Marker names carry identifiers, while the trace supplies its unified clock. */
+static inline void lorieTraceTriple(const char *stage, uint64_t a, uint64_t b, uint64_t c) {
+    if (!ATrace_isEnabled()) return;
+    char name[120];
+    snprintf(name, sizeof(name), "PAD_X11.%s.%llu.%llu.%llu", stage,
+             (unsigned long long)a, (unsigned long long)b, (unsigned long long)c);
+    ATrace_beginSection(name);
+    ATrace_endSection();
+}
+static inline void lorieTraceEvent(const char *stage, uint64_t a, uint64_t b) {
+    lorieTraceTriple(stage, a, b, 0);
+}
diff --git a/lorie/src/main/cpp/lorie/frame-pacing.h b/lorie/src/main/cpp/lorie/frame-pacing.h
index 3597fc7..4fb02dd 100644
--- a/lorie/src/main/cpp/lorie/frame-pacing.h
+++ b/lorie/src/main/cpp/lorie/frame-pacing.h
@@ -42,3 +42,13 @@ lorieFramePacerAccept(LorieFramePacer *pacer, uint64_t frameTimeNanos, uint32_t
     pacer->nextFrameNanos += ((frameTimeNanos - pacer->nextFrameNanos) / interval + 1) * interval;
     return true;
 }
+
+/* Virtual MSC continues across idle without requesting callbacks to count it.
+ * Notifications still fire only at an accepted Choreographer tick. */
+static inline uint64_t lorieFrameClockMSC(uint64_t epoch, uint64_t now, uint32_t rate, uint64_t previous) {
+    if (!rate || now < epoch) return previous;
+    const uint64_t elapsed = now - epoch;
+    const uint64_t msc = elapsed / UINT64_C(1000000000) * rate +
+                         elapsed % UINT64_C(1000000000) * rate / UINT64_C(1000000000) + 1;
+    return msc > previous ? msc : previous;
+}
