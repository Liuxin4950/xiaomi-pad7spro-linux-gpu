diff --git a/lorie/src/main/cpp/lorie/frame-pacing.h b/lorie/src/main/cpp/lorie/frame-pacing.h
new file mode 100644
index 0000000..3597fc7
--- /dev/null
+++ b/lorie/src/main/cpp/lorie/frame-pacing.h
@@ -0,0 +1,44 @@
+#pragma once
+
+#include <stdbool.h>
+#include <stdint.h>
+
+/* Owned by the X server thread. The callback timestamp uses CLOCK_MONOTONIC. */
+typedef struct {
+    uint64_t nextFrameNanos;
+    uint64_t lastFrameNanos;
+    uint32_t rate;
+    bool initialized;
+} LorieFramePacer;
+
+static inline bool
+lorieFramePacerAccept(LorieFramePacer *pacer, uint64_t frameTimeNanos, uint32_t rate)
+{
+    uint64_t interval;
+
+    if (!rate) {
+        pacer->initialized = false;
+        return true;
+    }
+
+    /* Round down by less than one ns so an exact 120 Hz source is not reduced
+     * to 40 Hz by rounding a 60 Hz deadline up past every second callback. */
+    interval = UINT64_C(1000000000) / rate;
+    if (!interval)
+        interval = 1;
+
+    if (!pacer->initialized || pacer->rate != rate || frameTimeNanos < pacer->lastFrameNanos) {
+        pacer->initialized = true;
+        pacer->rate = rate;
+        pacer->nextFrameNanos = frameTimeNanos;
+    }
+    pacer->lastFrameNanos = frameTimeNanos;
+
+    if (frameTimeNanos < pacer->nextFrameNanos)
+        return false;
+
+    /* Keep phase across uneven callbacks, and skip missed deadlines after a
+     * stall instead of dispatching a burst of catch-up frames. */
+    pacer->nextFrameNanos += ((frameTimeNanos - pacer->nextFrameNanos) / interval + 1) * interval;
+    return true;
+}
