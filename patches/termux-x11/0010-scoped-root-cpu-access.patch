+/* End a CPU mapping before publishing GPU work. EXA PrepareAccess/FinishAccess already
+ * provide scoped CPU mappings; retaining and cycling a root AHB mapping on GPU-only frames
+ * needlessly cleans/invalidates the entire screen and can stall the display-clock thread. */
+static void lorieReleaseCpuMapping(LoriePixmapPriv *priv) {
+    if (!priv || !priv->buffer || !priv->locked)
+        return;
+    int status = LorieBuffer_unlock(priv->buffer);
+    priv->locked = NULL;
+    priv->wasLocked = FALSE;
+    if (status)
+        FatalError("Failed to release CPU mapping before GPU access: %d\n", status);
+}
