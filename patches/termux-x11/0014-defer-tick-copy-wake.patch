 static void loriePerformVblanks(void);
 
+static void loriePerformFrameVblanks(void) {
+    /* Enqueue wakes used to race the still-closed frame permit, splitting a
+     * copy and its root draw into two flush/fence round trips. Already-running
+     * drains remain allowed, including those needed by a CPU fallback. */
+    deferGpuCopyWake = TRUE;
+    loriePerformVblanks();
+    deferGpuCopyWake = FALSE;
+    lorieFrameGateTick(&pvfb->state->waitForNextFrame);
+    if (__atomic_load_n(&pvfb->state->gpuCopyQueue.writeIndex, __ATOMIC_ACQUIRE) !=
+        __atomic_load_n(&pvfb->state->gpuCopyQueue.readIndex, __ATOMIC_ACQUIRE))
+        pthread_cond_signal(rendererCond);
+}
