diff --git a/wsi/x11/timeline.hpp b/wsi/x11/timeline.hpp
new file mode 100644
index 0000000..47cf81d
--- /dev/null
+++ b/wsi/x11/timeline.hpp
@@ -0,0 +1,61 @@
+// SPDX-License-Identifier: MIT
+#pragma once
+#include <array>
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <fcntl.h>
+#include <mutex>
+#include <unistd.h>
+namespace wsi { namespace x11 {
+struct timeline
+{
+   struct event_record { uint64_t ns; const char *stage; uint32_t pixmap; uint64_t sequence, value; };
+   std::array<event_record, 65536> records{};
+   size_t count{0}; uint64_t dropped{0};
+   std::mutex lock;
+   int output{-1}, marker{-1};
+   explicit timeline(uint32_t window)
+   {
+      const char *directory = std::getenv("PAD_GPU_WSI_TIMELINE_DIR");
+      if (!directory) return;
+      char path[4096];
+      const int n = std::snprintf(path, sizeof(path), "%s/wsi-%d-%u-%llu.csv", directory, getpid(), window, static_cast<unsigned long long>(std::chrono::steady_clock::now().time_since_epoch().count()));
+      if (n > 0 && static_cast<size_t>(n) < sizeof(path))
+         output = open(path, O_WRONLY|O_CREAT|O_EXCL|O_CLOEXEC, 0600);
+      marker = open("/proc/1/root/sys/kernel/tracing/trace_marker", O_WRONLY|O_CLOEXEC);
+   }
+   void record(const char *stage, uint32_t pixmap, uint64_t sequence, uint64_t value=0)
+   {
+      const uint64_t ns = std::chrono::duration_cast<std::chrono::nanoseconds>(
+         std::chrono::steady_clock::now().time_since_epoch()).count();
+      { const std::lock_guard<std::mutex> guard(lock);
+        if (count < records.size()) records[count++] = {ns, stage, pixmap, sequence, value};
+        else ++dropped; }
+      // Persist in Perfetto as well, so a killed GPU process does not lose its last events.
+      if (marker >= 0) {
+         char line[160]; const int n = std::snprintf(line, sizeof(line), "C|%d|PAD_WSI.%s.%u|%llu", getpid(), stage, pixmap,
+            static_cast<unsigned long long>(value ? value : sequence));
+         if (n > 0 && static_cast<size_t>(n) < sizeof(line)) (void)write(marker, line, n);
+      }
+   }
+   ~timeline()
+   {
+      // Owner destroys this only after joining all workers; no per-frame file writes.
+      if (output >= 0) {
+         FILE *file = fdopen(output, "w");
+         if (file) {
+            std::fprintf(file, "monotonic_ns,stage,pixmap,sequence,value\n");
+            for (size_t i=0;i<count;++i) {
+               const auto &e=records[i];
+               std::fprintf(file, "%llu,%s,%u,%llu,%llu\n", static_cast<unsigned long long>(e.ns), e.stage, e.pixmap,
+                  static_cast<unsigned long long>(e.sequence), static_cast<unsigned long long>(e.value));
+            }
+            std::fclose(file);
+         } else close(output);
+      }
+      if (marker >= 0) close(marker);
+      if (dropped) std::fprintf(stderr, "PAD_WSI_TIMELINE_DROPPED=%llu\n", static_cast<unsigned long long>(dropped));
+   }
+};
+} }
