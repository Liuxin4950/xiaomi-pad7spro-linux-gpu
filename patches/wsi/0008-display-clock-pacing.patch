+// Versioned root property is published only by the cooperating display server.
+// RandR refresh is not evidence that a legacy server enforces a display clock.
+void swapchain::negotiate_display_clock()
+{
+   // Explicit zero keeps the existing uncapped WSI contract.
+   if (!m_max_present_fps) return;
+   const char *policy = std::getenv("PAD_GPU_PRESENT_CLOCK");
+   if (policy && std::strcmp(policy, "timer") == 0) return;
+   const auto geometry_cookie = xcb_get_geometry(m_connection, m_window);
+   auto geometry = xcb_get_geometry_reply(m_connection, geometry_cookie, nullptr);
+   if (!geometry) return;
+   const auto root = geometry->root;
+   free(geometry);
+   constexpr char name[] = "_TERMUX_X11_DISPLAY_CLOCK";
+   auto atom = xcb_intern_atom_reply(m_connection,
+      xcb_intern_atom(m_connection, 1, sizeof(name)-1, name), nullptr);
+   if (!atom) return;
+   const auto property = atom->atom;
+   free(atom);
+   if (!property) return;
+   auto reply = xcb_get_property_reply(m_connection,
+      xcb_get_property(m_connection, 0, root, property, XCB_ATOM_CARDINAL, 0, 3), nullptr);
+   if (!reply) return;
+   if (reply->type == XCB_ATOM_CARDINAL && reply->format == 32 &&
+       reply->bytes_after == 0 && xcb_get_property_value_length(reply) == 12)
+   {
+      const auto words = static_cast<const uint32_t *>(xcb_get_property_value(reply));
+      // Flags 1+2: Choreographer clock and target-MSC scheduling. A lower user cap
+      // still uses the original timer; no implicit uncapped override.
+      if (words[0] == 1 && words[1] > 0 && words[1] <= 240 && (words[2] & 3) == 3 &&
+          words[1] <= m_max_present_fps)
+         m_display_clock_fps = words[1];
+   }
+   free(reply);
+}
