+
+bool supports_bgra_conversion(const layer::instance_private_data &instance, VkPhysicalDevice physical_device)
+{
+   uint32_t family_count = 0;
+   instance.disp.GetPhysicalDeviceQueueFamilyProperties2KHR(physical_device, &family_count, nullptr);
+   if (family_count != 1)
+      return false;
+   VkQueueFamilyProperties2 family{ VK_STRUCTURE_TYPE_QUEUE_FAMILY_PROPERTIES_2, nullptr, {} };
+   instance.disp.GetPhysicalDeviceQueueFamilyProperties2KHR(physical_device, &family_count, &family);
+   if (!(family.queueFamilyProperties.queueFlags & VK_QUEUE_GRAPHICS_BIT))
+      return false;
+   VkFormatProperties2 source{ VK_STRUCTURE_TYPE_FORMAT_PROPERTIES_2, nullptr, {} };
+   VkFormatProperties2 destination{ VK_STRUCTURE_TYPE_FORMAT_PROPERTIES_2, nullptr, {} };
+   instance.disp.GetPhysicalDeviceFormatProperties2KHR(physical_device, VK_FORMAT_B8G8R8A8_UNORM, &source);
+   instance.disp.GetPhysicalDeviceFormatProperties2KHR(physical_device, VK_FORMAT_R8G8B8A8_UNORM, &destination);
+   return (source.formatProperties.optimalTilingFeatures & VK_FORMAT_FEATURE_BLIT_SRC_BIT) &&
+          (destination.formatProperties.linearTilingFeatures & VK_FORMAT_FEATURE_BLIT_DST_BIT);
+}
 
