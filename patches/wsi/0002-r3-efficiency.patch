diff --git a/wsi/x11/diagnostics.hpp b/wsi/x11/diagnostics.hpp
new file mode 100644
index 0000000..2ba0553
--- /dev/null
+++ b/wsi/x11/diagnostics.hpp
@@ -0,0 +1,59 @@
+// SPDX-License-Identifier: MIT
+#pragma once
+#include <algorithm>
+#include <array>
+#include <chrono>
+#include <cstdint>
+#include <cstdio>
+#include <memory>
+
+namespace wsi { namespace x11 {
+// Opt-in bounded host timestamps. No per-frame logging or heap allocation.
+// Each metric has one writer; report only after the workers have joined.
+struct diagnostic_metric
+{
+   std::array<uint64_t, 1024> samples{};
+   uint64_t count{0}, total{0}, maximum{0};
+   void add(uint64_t ns)
+   {
+      samples[count++ % samples.size()] = ns;
+      total += ns;
+      maximum = std::max(maximum, ns);
+   }
+   void report(uint32_t window, const char *name) const
+   {
+      if (!count) return;
+      auto sorted = samples;
+      const size_t n = std::min<uint64_t>(count, samples.size());
+      std::sort(sorted.begin(), sorted.begin() + n);
+      std::fprintf(stderr, "PAD_WSI metric=%s window=%u count=%llu samples=%zu mean_us=%.3f max_us=%.3f p50_us=%.3f p95_us=%.3f p99_us=%.3f\n",
+         name, window, static_cast<unsigned long long>(count), n,
+         static_cast<double>(total) / count / 1000., maximum / 1000.,
+         sorted[(n-1)*50/100] / 1000., sorted[(n-1)*95/100] / 1000., sorted[(n-1)*99/100] / 1000.);
+   }
+};
+struct diagnostics
+{
+   diagnostic_metric host_payload, gpu_ready_wait, present_interval;
+   uint64_t recordings{0}, copies{0}, last_present{0};
+   static uint64_t now()
+   {
+      return std::chrono::duration_cast<std::chrono::nanoseconds>(
+         std::chrono::steady_clock::now().time_since_epoch()).count();
+   }
+   void present()
+   {
+      const auto current = now();
+      if (last_present) present_interval.add(current - last_present);
+      last_present = current;
+   }
+   void report(uint32_t window, bool reuse) const
+   {
+      std::fprintf(stderr, "PAD_WSI window=%u reuse=%u recordings=%llu copies=%llu\n", window, reuse,
+         static_cast<unsigned long long>(recordings), static_cast<unsigned long long>(copies));
+      host_payload.report(window, "host_payload");
+      gpu_ready_wait.report(window, "gpu_ready_wait");
+      present_interval.report(window, "x11_submit_interval");
+   }
+};
+} }
