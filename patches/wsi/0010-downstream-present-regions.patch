+// Return a conservative union relative to the last *downstream* submission.
+// A bounded history retains skipped MAILBOX payloads and future queued frames.
+// Missing/invalid history and unsupported X11 coordinate ranges copy the full image.
+present_damage swapchain::damage_since(uint64_t sequence)
+{
+   present_damage result{};
+   if (!sequence || !m_last_update_sequence || sequence <= m_last_update_sequence ||
+       sequence - m_last_update_sequence > DAMAGE_HISTORY)
+      return result;
+   result.status = present_damage::RECTS;
+   for (uint64_t n = m_last_update_sequence + 1; n <= sequence; ++n) {
+      const auto &entry = m_damage_history[n % DAMAGE_HISTORY];
+      if (entry.sequence != n || entry.damage.status != present_damage::RECTS ||
+          !entry.damage.rect_count || entry.damage.rect_count > present_damage::MAX_RECTS)
+         return present_damage{};
+      for (uint32_t i = 0; i < entry.damage.rect_count; ++i) {
+         auto rect = entry.damage.rects[i];
+         if (rect.offset.x < 0 || rect.offset.y < 0 || rect.offset.x > INT16_MAX || rect.offset.y > INT16_MAX ||
+             !rect.extent.width || !rect.extent.height || rect.extent.width > UINT16_MAX || rect.extent.height > UINT16_MAX ||
+             static_cast<uint64_t>(rect.offset.x) + rect.extent.width > m_image_create_info.extent.width ||
+             static_cast<uint64_t>(rect.offset.y) + rect.extent.height > m_image_create_info.extent.height)
+            return present_damage{};
+         for (uint32_t r = 0; r < result.rect_count;) {
+            if (merge_damage_rects(rect, result.rects[r])) {
+               result.rects[r] = result.rects[--result.rect_count]; r = 0;
+            } else ++r;
+         }
+         if (result.rect_count == present_damage::MAX_RECTS) return present_damage{};
+         result.rects[result.rect_count++] = rect;
+      }
+   }
+   return result;
+}
