+   enum status_kind : uint8_t { UNKNOWN = 0, RECTS = 1 };
    static constexpr uint32_t MAX_RECTS = 12;
    status_kind status{ UNKNOWN };
    uint32_t rect_count{ 0 };
    VkRect2D rects[MAX_RECTS]{};
+
+   static present_damage from_region(const VkPresentRegionKHR &region)
+   {
+      present_damage damage{};
+      if (!region.rectangleCount || region.rectangleCount > MAX_RECTS || !region.pRectangles)
+         return damage;
+      for (uint32_t r = 0; r < region.rectangleCount; ++r)
+      {
+         if (region.pRectangles[r].layer != 0)
+            return present_damage{};
+         damage.rects[r] = { region.pRectangles[r].offset, region.pRectangles[r].extent };
+      }
+      damage.status = RECTS;
+      damage.rect_count = region.rectangleCount;
+      return damage;
+   }
 };
 
